# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted Applet URL
APP_URL="MY_APP_URL"

# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration
DATABASE_URL=postgresql://user:pass@host:5432/db

# Exchange Rate Service Configuration
EXCHANGE_RATE_API_URL=https://api.budjet.org/fiat/USD/ETB
EXCHANGE_RATE_FALLBACK=159.98
EXCHANGE_RATE_CACHE_DURATION=3600

# JWT Authentication
JWT_SECRET=your-super-secret-key-min-32-characters
JWT_EXPIRY=24h

# CORS Settings
ALLOWED_ORIGINS=https://delta-admin-beta.vercel.app,https://delta-public-website.vercel.app,http://localhost:5173,http://localhost:5174,http://localhost:3000

# Admin Default Credentials
ADMIN_EMAIL=admin@deltatravel.com
ADMIN_PASSWORD_HASH=$2a$10$vYq...

# Twilio SMS Credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# Email SMTP Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@deltatravel.com
SMTP_PASS=mock_app_password
ADMIN_NOTIFICATION_EMAIL=admin@deltatravel.com

# File Upload Configuration
UPLOAD_PATH=./uploads
UPLOAD_MAX_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Cloudinary Storage Configuration (Optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
